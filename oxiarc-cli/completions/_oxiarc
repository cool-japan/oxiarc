#compdef oxiarc

autoload -U is-at-least

_oxiarc() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_oxiarc_commands" \
"*::: :->oxiarc" \
&& ret=0
    case $state in
    (oxiarc)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:oxiarc-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'-s+[Sort entries by\: name, size, date, or ratio]:SORT:((name\:"Sort by name (alphabetical)"
size\:"Sort by file size"
date\:"Sort by modification date"
ratio\:"Sort by compression ratio (compressed_size / original_size)"))' \
'--sort=[Sort entries by\: name, size, date, or ratio]:SORT:((name\:"Sort by name (alphabetical)"
size\:"Sort by file size"
date\:"Sort by modification date"
ratio\:"Sort by compression ratio (compressed_size / original_size)"))' \
'*-I+[Include only files matching pattern (glob syntax\: *.txt, src/**/*)]:INCLUDE:_default' \
'*--include=[Include only files matching pattern (glob syntax\: *.txt, src/**/*)]:INCLUDE:_default' \
'*-X+[Exclude files matching pattern (glob syntax)]:EXCLUDE:_default' \
'*--exclude=[Exclude files matching pattern (glob syntax)]:EXCLUDE:_default' \
'--memory-limit=[Refuse to extract entries exceeding this memory limit (e.g. 100M, 512K, 1G)]:MEMORY_LIMIT:_default' \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Show verbose output]' \
'--verbose[Show verbose output]' \
'-j[Output as JSON (machine-readable)]' \
'--json[Output as JSON (machine-readable)]' \
'-T[Display as directory tree]' \
'--tree[Display as directory tree]' \
'-r[Reverse sort order]' \
'--reverse[Reverse sort order]' \
'--lenient[Continue on corruption when reading the archive (emit warnings to stderr)]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':archive -- Archive file to list (use "-" for stdin):_default' \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
'-o+[Output directory (use "-" for stdout when extracting single-file formats)]:OUTPUT:_default' \
'--output=[Output directory (use "-" for stdout when extracting single-file formats)]:OUTPUT:_default' \
'*-I+[Include only files matching pattern (glob syntax\: *.txt, src/**/*)]:INCLUDE:_default' \
'*--include=[Include only files matching pattern (glob syntax\: *.txt, src/**/*)]:INCLUDE:_default' \
'*-X+[Exclude files matching pattern (glob syntax)]:EXCLUDE:_default' \
'*--exclude=[Exclude files matching pattern (glob syntax)]:EXCLUDE:_default' \
'-f+[Format hint for stdin (gzip, xz, bz2, lz4, zst, br, snappy)]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'--format=[Format hint for stdin (gzip, xz, bz2, lz4, zst, br, snappy)]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'--password=[Password for encrypted entries (prompts interactively if omitted)]:PASSWORD:_default' \
'--memory-limit=[Refuse to extract entries exceeding this memory limit (e.g. 100M, 512K, 1G)]:MEMORY_LIMIT:_default' \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Show verbose output]' \
'--verbose[Show verbose output]' \
'-P[Show progress bar (opt-in; off by default)]' \
'--progress[Show progress bar (opt-in; off by default)]' \
'--overwrite[Always overwrite existing files (default behavior)]' \
'--skip-existing[Skip extraction if file already exists]' \
'--prompt[Prompt user before overwriting each file]' \
'-t[Preserve file timestamps (modification time)]' \
'--preserve-timestamps[Preserve file timestamps (modification time)]' \
'--preserve-permissions[Preserve file permissions (Unix mode)]' \
'-p[Preserve all metadata (timestamps and permissions)]' \
'--preserve[Preserve all metadata (timestamps and permissions)]' \
'-n[Dry run\: show what would be extracted without writing files]' \
'--dry-run[Dry run\: show what would be extracted without writing files]' \
'--strict-names[Refuse to extract entries whose basename is a Windows reserved name (CON, NUL, COM1.., LPT1..). Default\: append '\''_'\'' to the stem]' \
'--lenient[Continue on corruption (CRC mismatch, bad TAR checksum, etc.) with warnings instead of errors]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':archive -- Archive file to extract (use "-" for stdin):_default' \
'*::files -- Files to extract (all if empty):_default' \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Show verbose output]' \
'--verbose[Show verbose output]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help]' \
'--help[Print help]' \
':archive -- Archive file to test (use "-" for stdin):_default' \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
'-f+[Archive format (required for stdout\: gzip, xz, bz2, lz4, zst, br, snappy)]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'--format=[Archive format (required for stdout\: gzip, xz, bz2, lz4, zst, br, snappy)]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'-l+[Compression level]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--compression=[Compression level]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--compress-threshold=[Files smaller than this (bytes) are stored, not compressed (ZIP only; 0 disables)]:COMPRESS_THRESHOLD:_default' \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Verbose output]' \
'--verbose[Verbose output]' \
'-n[Dry run\: show what would be done without creating the archive]' \
'--dry-run[Dry run\: show what would be done without creating the archive]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':archive -- Output archive file (use "-" for stdout):_default' \
'*::files -- Files to add to the archive:_files' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'-l+[Compression level (used when the archive format supports it)]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--compression=[Compression level (used when the archive format supports it)]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Verbose output]' \
'--verbose[Verbose output]' \
'-n[Dry run\: show planned changes without modifying the archive]' \
'--dry-run[Dry run\: show planned changes without modifying the archive]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':archive -- Existing archive file to append to:_files' \
'*::files -- Files to add to the archive:_files' \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help]' \
'--help[Print help]' \
':archive -- Archive file to inspect (use "-" for stdin):_default' \
&& ret=0
;;
(detect)
_arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- File to detect (use "-" for stdin):_default' \
&& ret=0
;;
(convert)
_arguments "${_arguments_options[@]}" : \
'-f+[Output format (zip, tar, gzip, lzh, xz, lz4, br, snappy) - auto-detected from extension if not specified]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'--format=[Output format (zip, tar, gzip, lzh, xz, lz4, br, snappy) - auto-detected from extension if not specified]:FORMAT:((zip\:"ZIP archive"
tar\:"TAR archive"
gzip\:"GZIP compressed file"
lzh\:"LZH archive"
xz\:"XZ compressed file"
lz4\:"LZ4 compressed file"
bz2\:"Bzip2 compressed file"
zst\:"Zstandard compressed file"
br\:"Brotli compressed file"
snappy\:"Snappy compressed file"))' \
'-l+[Compression level for output]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--compression=[Compression level for output]:COMPRESSION:((store\:"Store without compression"
fast\:"Fast compression"
normal\:"Normal compression (default)"
best\:"Best compression"))' \
'--color=[Control color output]:COLOR:(auto always never)' \
'-v[Verbose output]' \
'--verbose[Verbose output]' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':input -- Input archive file:_files' \
':output -- Output archive file:_files' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : \
'--color=[Control color output]:COLOR:(auto always never)' \
'-q[Suppress non-error output]' \
'--quiet[Suppress non-error output]' \
'-h[Print help]' \
'--help[Print help]' \
'::out_dir -- Directory to write man pages into (default\: ./man):_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_oxiarc__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:oxiarc-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(detect)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(convert)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_oxiarc_commands] )) ||
_oxiarc_commands() {
    local commands; commands=(
'list:List contents of an archive' \
'extract:Extract files from an archive' \
'test:Test archive integrity' \
'create:Create a new archive' \
'add:Add files to an existing archive (ZIP, TAR, LZH)' \
'info:Show information about an archive' \
'detect:Detect archive format' \
'convert:Convert archive to another format' \
'completion:Generate shell completion scripts' \
'man:Generate man pages for all subcommands' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'oxiarc commands' commands "$@"
}
